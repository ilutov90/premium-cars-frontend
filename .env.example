# Copy to .env.local and adjust. No secrets here: the frontend has none.
# Backend URL used by the Next.js server: server components call it, and /api + /media are forwarded to it.
# Read at build/start time.
API_URL=http://localhost:8080
# Public address of the site (links and preview images when a car is shared). Locally:
SITE_URL=http://localhost:3000
