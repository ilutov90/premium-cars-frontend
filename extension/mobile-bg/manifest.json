{
  "manifest_version": 3,
  "name": "Premium Cars → mobile.bg и cars.bg",
  "version": "1.1.0",
  "description": "Попълва обявите в mobile.bg и cars.bg с данните от админ панела на Premium Cars Import. Бутоните за публикуване ги натиска админът.",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://www.mobile.bg/*",
    "https://www.cars.bg/*",
    "https://premiumcarsimport.bg/*",
    "http://localhost/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://premiumcarsimport.bg/admin/*", "http://localhost/admin/*"],
      "js": ["admin-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.mobile.bg/*"],
      "js": ["mobilebg-page.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.mobile.bg/*"],
      "js": ["mobilebg.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.cars.bg/*"],
      "js": ["carsbg-page.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.cars.bg/*"],
      "js": ["carsbg.js"],
      "run_at": "document_idle"
    }
  ]
}
